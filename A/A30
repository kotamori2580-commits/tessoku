#include <bits/stdc++.h>
using namespace std;

long long Power(long long a, long long b, long long m){
  long long p=a;
  long long ans=1;
  for(int i=0;i<=30;i++){
    int wari = (1<<i);
    if((b/wari)%2 == 1){
      ans = (ans*p)%m;
    }
    p = (p*(p%m)%m);
  }
  return ans;
}

long long div(long long a, long long b, long long m){
  return (a*Power(b, m-2, m))%m;
}

int main(){
  int n, r;
  cin >> n >> r;
  
  long long m = 1000000007;
  long long a=1;
  for(int i=1;i<=n;i++){
    a = (a*(i%m))%m;
  }
  
  long long b=1;
  for(int i=1;i<=r;i++){
    b = (b*(i%m))%m;
  }
  for(int i=1;i<=n-r;i++){
    b = (b*(i%m))%m;
  }
  
  cout << div(a, b, m) << "\n";
}
