#include <bits/stdc++.h>
using namespace std;

int N;
int A(N+1), (N+1);

int main(){
  cin >> N;
  for(int i=1;i<=N;i++){
    cin >> A[i];
  }
  for(int i=1;i<=N;i++){
    cin >> B[i];
  }
  sort(B.begin(), B.end(), greater());
  sort(A.begin(), A.end());
  long long ans=0;
  for(int i=1;i<=N;i++){
    ans += A[i]*B[i];
  }
  cout << ans << "\n";
}
