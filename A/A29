#include <bits/stdc++.h>
using namespace std;

vector<int> vec;

int main(){
  long long a, b;
  cin >> a >> b;
  for(long long i=1;i<=b;i++){
    int n = (a^i)%1000000007;
    
    if(i==1){
      vec.push_back(n);      
    }
    else{
      bool flag = true;
      if(vec[0] == n){
        break;
      }
      else{
        vec.push_back(n);
      } 
    }
  }
  int t;
  t = vec.size();
  cout << vec[b%t-1] << "\n";
}
