#include <bits/stdc++.h>
using namespace std;

vector<vector<int>> G[100009];
int dp[100009];
int A[100009];

int main(){
  int N;
  cin >> N;
  for(int i=2;i<=N;i++){
    cin >> A[i];
    G[A[i]].push_back(i);
  }
  
  for(int i=N;i<=1;i--){
    for(int j=0;j<G[i].size();j++){
      dp[i] += (dp[G[i][j]]+1);
    }
  }
  
  for(int i=1;i<=N;i++){
    cout << dp[i] << "\n";
  }
}
