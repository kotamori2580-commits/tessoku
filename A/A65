 * 難易度（体感）：★★★★☆
 * 結果：できんかった
 * 解法：動的計画法
 * * 【学んだこと・ポイント】
 * ・グラフに対する動的計画法を学んだ
 * * 【反省・詰まった点】
 * ・いまのままだと「vector<vector<int>> の配列」です。 3次元構造（[社員ID] → [グループ] → [部下リスト]）になってしまいます
 * * 【計算量】
 * ・O(N)
 */

#include <bits/stdc++.h>
using namespace std;

vector<vector<int>> G[100009];
int dp[100009];
int A[100009];

int main(){
  int N;
  cin >> N;
  for(int i=2;i<=N;i++){
    cin >> A[i];
    G[A[i]].push_back(i);
  }
  
  for(int i=N;i<=1;i--){
    for(int j=0;j<G[i].size();j++){
      dp[i] += (dp[G[i][j]]+1);
    }
  }
  
  for(int i=1;i<=N;i++){
    cout << dp[i] << "\n";
  }
}
