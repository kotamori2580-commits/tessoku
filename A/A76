  cin >> N >> W >> L >> R;
  for(int i=1;i<=N;i++){
    cin >> X[i];
  }
  X[0] = 0;
  X[N+1] = W;
  
  dp[0]=1;
  sum[0]=1;
  int ans = 0;
  for(int i=1;i<=(N+1);i++){
    int posL = lower_bound(X, X+N+2, X[i]-R)-X;
    int posR = lower_bound(X, X+N+2, X[i]-L+1)-X;
    dp[i]=sum[posR-1]-sum[posL-1];
    sum[i] = sum[i-1] + dp[i];
  }
  ans = (dp[N+1]+mod)%mod;
  
