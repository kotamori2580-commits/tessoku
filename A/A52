#include <bits/stdc++.h>
using namespace std;

int main(){
  int Q;
  cin >> Q;
  queue<string> T;
  for(int i=1;i<=Q;i++){
    int a;
    cin >> a;
    if(a==1){
      string name;
      cin >> name;
      T.push(name);
    }
    else if(a==2){
      cout << T.front() << "\n";
    }
    else{
      T.pop();
    }
  }
}
