#include <bits/stdc++.h>
using namespace std;

int main(){
  int N, A, B;
  cin >> N >> A >> B;
  int s = min (A, B);
  int t = A + B - s;
  int n=N/(s+t);
  if ((s+t)*n <= N && N <= (s+t)*n+s-1){
    cout << "Second" << "\n";
  }
  else{
    cout << "First" << "\n";
  }
}
