 * 難易度（体感）：★★★☆☆
 * 結果：CE
 * 解法：[幅探索]
 * * 【学んだこと・ポイント】
 * ・queueの先頭を取り出すときはfrontを使う
 * * 【反省・詰まった点】
 * ・BFSの基本テンプレートはそのまま暗記する
 * * 【計算量】
 * ・O(N+M)
 */

#include <bits/stdc++.h>
using namespace std;

int main(){
  int N,M;
  cin >> N >> M;
  vector<vector<int>> vec(N+1);
  for(int i=0;i<M;i++){
    int A,B;
    cin >> A >> B;
    vec[A].push_back(B);
    vec[B].push_back(A);
  }
  
  vector<int> dist(N+1);
  for(int i=1;i<=N;i++){
    dist[i] = -1;
  }
  dist[1] = 0;
  queue<int> Q;
  Q.push(1);
  int pos = 0;
  
  for(int i=0;i<vec[pos].size();i++){
    pos = Q.top();
    Q.pop();
    if(vec[pos].size() != 0 && dist[vec[pos][i]] == -1){
      to = vec[pos][i];
      dist[to] = dist[pos] + 1;
      Q.push(to);
    }
    if(Q.empty()){
      break;
    }
  }
}
