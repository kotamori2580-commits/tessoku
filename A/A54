#include <bits/stdc++.h>
using namespace std;

int main(){
  int Q;
  cin >> Q;
  map<string, int> MAP;
  for(int i=1;i<=Q;i++){
    int a;
    cin >> a;
    if(a==1){
      string name1;
      cin >> name1;
      cin >> MAP[name1];
    }
    else{
      string name2;
      cin >> name2;
      cout << MAP[name2] << "\n";
    }
  }
}
