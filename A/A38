/**
 * 難易度（体感）：★★★☆☆
 * 結果：WA
 * 解法：[]
 * * 【学んだこと・ポイント】
 * ・L[j]<=i && i<=R[j] と二つに分けて記述する
 * * 【反省・詰まった点】
 * ・制約がない日に100時間働くことになってしまう、、
 * * 【計算量】
 * ・O(ND)
 */

#include <bits/stdc++.h>
using namespace std;

long long ls[400];
int L[10009],R[10009],H[10009];

int main(){
  int D, N;
  cin >> D >> N;
  for(int i=1;i<=N;i++){
    cin >> L[i] >> R[i] >> H[i];
  }
  for(int i=1;i<=D;i++){
    ls[i] = 100;
  }  
  
  for(int i=1;i<=D;i++){
    for(int j=1;j<=N;j++){
      if(L[j]<=i && i<=R[j] && H[j]<ls[i]){
        ls[i] = H[j];
      }
    }
  }
  
  long long ans=0;
  for(int i=1;i<=D;i++){
    ans += ls[i];
  } 
  cout << ans << "\n";
}
