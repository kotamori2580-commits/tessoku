#include <bits/stdc++.h>
using namespace std;

int main(){
  int N,M;
  cin >> N >> M;
  vector<vector<int>> vec(N);
  for(int =0;i<M;i++){
    int A,B;
    cin >> A >>B;
    vec[A].push_back(B);
    vec[B].push_back(A);
  }
  for(int i=1;i<=N;i++){
    cout << i << ":" << vec[i] << "\n";
  }
}
