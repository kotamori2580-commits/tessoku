#include <bits/stdc++.h>
using namespace std;

int X[10009];

bool isPrime(int x){
  bool flag=true;  
  for(int i=2;i*i<=x;i++){
    if(x%i == 0){
      flag = false;
    }
  }
  return flag;  
}

int main(){
  int Q;
  cin >> Q;
  for(int i=1;i<=Q;i++){
    cin >> X[i];
    if(isPrime(X[i])){
      cout << "Yes" << "\n";
    }
    else{
      cout << "No" << "\n";
    }
  }
}
